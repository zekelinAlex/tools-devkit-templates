{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.UI.Cells",
  "name": "Power Platform: Entity Form Cells",
  "shortName": "pp-form-cell",
  "description": "HIERARCHY: inside Row (pp-form-row) -> wraps Control (pp-form-control). Generates cell.xml (standard) + dialogcell.xml (dialog). Direct container for a single field label + control.",
  "tags": {
    "language": "XML",
    "type": "item"
  },
  "sourceName": "examplecustomentityattribute",
  "preferNameDirectory": false,
  "symbols": {
    "EntityLogicalName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "__entity-logical-name__",
      "isRequired": false,
      "defaultValue": "unknown",
      "description": "Logical name of the entity including publisher prefix (e.g., udpp_warehouseitem)"
    },
    "SolutionRootPath": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "__solution-declarations-root__",
      "defaultValue": ".",
      "isRequired": false,
      "description": "Path to the solution root directory"
    },
    "FormId": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknownFormId",
      "replaces": "__form-id__",
      "description": "GUID of the specific form where the cell will be added"
    },
    "FormType": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "replaces": "__form-type__",
      "defaultValue": "unknown",
      "choices": [
        {
          "choice": "main"
        },
        {
          "choice": "quick"
        },
        {
          "choice": "dialog"
        },
        {
          "choice": "unknown"
        }
      ],
      "description": "Type of form: main (main form), quick (quick create), dialog (dialog form), or unknown (auto-detect)"
    },
    "SetToTabFooter": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "False",
      "replaces": "settotabfooterchoice",
      "choices": [
        {
          "choice": "True"
        },
        {
          "choice": "False"
        }
      ],
      "description": "Whether to add the cell to the tab footer (True) or to the main tab content (False)"
    },
    "RowId": {
      "type": "generated",
      "generator": "guid",
      "dataType": "string",
      "replaces": "__row-id__",
      "description": "Unique identifier for the row containing the cell (automatically generated GUID)"
    },
    "LabelId": {
      "type": "generated",
      "generator": "guid",
      "dataType": "string",
      "replaces": "__label-id__",
      "description": "Unique identifier for the cell label (automatically generated GUID)"
    },
    "DisplayName": {
      "type": "parameter",
      "datatype": "text",
      "replaces": "__display-name__",
      "isRequired": true,
      "description": "Display name for the cell label that will be shown to users"
    },
    "TabId": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__tab-id__",
      "description": "GUID of the specific tab where the cell will be added"
    },
    "TabIndex": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__tab-index__",
      "description": "Index number of the tab (1-based) where the cell will be added"
    },
    "ColumnIndex": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__column-index__",
      "description": "Index number of the column (1-based) within the tab where the cell will be added"
    },
    "SectionIndex": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__section-index__",
      "description": "Index number of the section (1-based) within the column where the cell will be added"
    },
    "RowIndex": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__row-index__",
      "description": "Index number of the row (1-based) within the section where the cell will be added"
    },
    "SectionId": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__section-id__",
      "description": "GUID of the specific section where the cell will be added"
    }
  },
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Add.ps1\" ",
        "redirectStandardOutput": "false"
      },
      "manualInstructions": [
        {
          "text": "Adding new row to form"
        }
      ],
      "continueOnError": false,
      "description": "Adding new row to form"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
        "redirectStandardOutput": "false"
      },
      "manualInstructions": [
        {
          "text": "Removing Scripts"
        }
      ],
      "continueOnError": false,
      "description": "Removing Scripts"
    }
  ]
}