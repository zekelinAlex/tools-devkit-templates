<Project Sdk="TALXIS.DevKit.Build.Sdk/1.2.2">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>__signing-key-file-path__</AssemblyOriginatorKeyFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ProjectType>WorkflowActivity</ProjectType>
    <AssemblyName>__talxis-workflow-activity-project__</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <Version>$(FileVersion)</Version>
    <Authors>__publisher-name__</Authors>
    <Company>NETWORG</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.*" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CrmSdk.Workflow" Version="*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Activities" />
  </ItemGroup>
</Project>
