{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.PackageDeployerPackage",
  "name": "Power Platform: Package Deployer Package",
  "shortName": "pp-package",
  "description": "Scaffolds a Package Deployer project. Script-only \u2014 generates PkgAssets/ with ImportConfig.xml (solution import order) + manifest.ppkg.json. Use when packaging multiple solutions for deployment. If a .sln/.slnx is found in the surrounding directory tree, the generated project is automatically added to it \u2014 no need to run 'dotnet sln add' afterwards.",
  "classifications": ["Dataverse", "Power Platform"],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "packagenameexample",
  "preferNameDirectory": true,
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/CreatePackage.ps1\""
      },
      "manualInstructions": [
        {
          "text": "Creating Package"
        }
      ],
      "description": "Create package"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/AddToSolution.ps1\"",
        "redirectStandardOutput": "false"
      },
      "manualInstructions": [
        {
          "text": "Add generated project to the nearest .slnx/.sln file: dotnet sln <path-to-sln> add <path-to-csproj>"
        }
      ],
      "continueOnError": true,
      "description": "Add generated project to .slnx/.sln (best-effort)"
    },
    {
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [{ "text": "Removing Scripts" }],
			"continueOnError": false,
			"description": "Removing Scripts"
		}
  ]
}