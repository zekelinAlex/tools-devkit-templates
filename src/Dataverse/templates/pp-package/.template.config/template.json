{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.PackageDeployerPackage",
  "name": "Power Platform: Package Deployer Package",
  "shortName": "pp-package",
  "description": "Scaffolds a Package Deployer project. Script-only \u2014 generates PkgAssets/ with ImportConfig.xml (solution import order) + manifest.ppkg.json. Use when packaging multiple solutions for deployment. After the project is created, it is automatically added to the nearest .slnx solution found in the surrounding directory tree \u2014 no need to run 'dotnet sln add' afterwards.",
  "classifications": ["Dataverse", "Power Platform"],
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "__talxis-pd-package-name__",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "__talxis-pd-package-name__.csproj"
    }
  ],
  "postActions": [
            {
      "description": "Add generated project to .sln file",
      "manualInstructions": [
        {
          "text": "Add generated project to .sln file"
        }
      ],
      "args": {
        "inRoot": true
      },
      "actionId": "D396686C-DE0E-4DE6-906D-291CD29FC5DE",
      "continueOnError": true,
      "primaryOutputIndexes": "0"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/CreatePackage.ps1\""
      },
      "manualInstructions": [
        {
          "text": "Creating Package"
        }
      ],
      "description": "Create package"
    },
    {
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [{ "text": "Removing Scripts" }],
			"continueOnError": false,
			"description": "Removing Scripts"
		}
  ]
}