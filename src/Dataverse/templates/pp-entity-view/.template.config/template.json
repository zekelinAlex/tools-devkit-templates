{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.View",
  "name": "Power Platform: View",
  "shortName": "pp-entity-view",
  "description": "Adds a SavedQuery (view) XML for an existing entity. Includes fetchxml, grid layout, column definitions. queryType=64. Use when adding a new list view to an entity.",
  "tags": {
    "language": "XML",
    "type": "item"
  },
  "sourceName": "customentity",
  "preferNameDirectory": false,
  "symbols": {
    "SolutionRootPath": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ".",
      "replaces": "SolutionDeclarationsRoot",
      "fileRename": "SolutionDeclarationsRoot",
      "description": "Path to the solution root directory"
    },
    "DisplayName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Generated",
      "replaces": "__display-name__",
      "description": "Display name of the view"
    },
    "EntityLogicalName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "__entity-logical-name__",
      "fileRename": "__entity-logical-name__",
      "description": "Logical name of the entity including publisher prefix (e.g., udpp_warehouseitem)"
    },
    "PublisherPrefix": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__publisher-prefix-default-value__",
      "replaces": "__publisher-prefix__",
      "fileRename": "__publisher-prefix__",
      "description": "Publisher prefix of the entity"
    },
    "ViewId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__view-id__",
      "fileRename": "__view-id__",
      "parameters": {
        "defaultFormat": "d"
      }
    }
  },
	"postActions": [
    {
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Init.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [
				{
					"text": "Set missing metadata values in template files and renaming files if necessary"
				}
			],
			"condition": "(PublisherPrefix == \"__publisher-prefix-default-value__\")",
			"description": "Setting missing metadata values in template files and renaming files if necessary"
		},
		{
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/SetFormId.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [
				{
					"text": "Setting view ID"
				}
			],
			"continueOnError": false,
			"description": "Setting view ID"
		},
		{
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [
				{
					"text": "Removing Scripts"
				}
			],
			"continueOnError": false,
			"description": "Removing Scripts"
		}
	]
}