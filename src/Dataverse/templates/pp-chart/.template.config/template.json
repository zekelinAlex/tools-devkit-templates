{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.Chart",
  "name": "Power Platform: Chart",
  "shortName": "pp-chart",
  "description": "Scaffolds an importable chart (savedqueryvisualization) under Entities/<entity>/Visualizations/{guid}.xml. Ships a starter fetch (count by statecode) and presentation matching the production TALXIS shape. ChartType is one of Bar, Line, Pie, Funnel, Column. Pass --ChartId for a fixed GUID; otherwise a fresh GUID is generated.",
  "classifications": ["Dataverse", "Power Platform"],
  "tags": {
    "language": "XML",
    "type": "item",
    "componentType": "Chart"
  },
  "sourceName": "TalxisDevKitTemplatesChartSourceNameSentinel",
  "preferNameDirectory": false,
  "symbols": {
    "SolutionRootPath": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ".",
      "replaces": "__solution-declarations-root__",
      "fileRename": "__solution-declarations-root__",
      "isRequired": false,
      "description": "Path to the solution root directory (default: '.')"
    },
    "EntitySchemaName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "__entity-schema-name__",
      "fileRename": "__entity-schema-name__",
      "description": "Logical name of the entity that owns the chart (e.g., tom_warehouseitem, Account). Must match the folder name under Entities/."
    },
    "ChartName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "__chart-name__",
      "description": "Display name of the chart (rendered as <LocalizedName languagecode=\"1033\">)."
    },
    "ChartType": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": true,
      "replaces": "__chart-type__",
      "description": "Chart series rendering style. Maps directly to the Series/@ChartType attribute.",
      "choices": [
        { "choice": "Bar", "description": "Horizontal bar chart." },
        { "choice": "Column", "description": "Vertical column chart." },
        { "choice": "Line", "description": "Line chart." },
        { "choice": "Pie", "description": "Pie chart." },
        { "choice": "Funnel", "description": "Funnel chart." }
      ]
    },
    "ChartId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__chart-id-default-value__",
      "description": "GUID for the chart. If omitted, a fresh GUID is auto-generated by the post-action. Accepts both braced ({xxx-xxx-xxx-xxx-xxxxxxxx}) and unbraced (xxx-xxx-xxx-xxx-xxxxxxxx) formats."
    }
  },
  "postActions": [
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/SetChartId.ps1\"",
        "redirectStandardOutput": "false"
      },
      "manualInstructions": [
        { "text": "Set chart visualizationid, rename file" }
      ],
      "continueOnError": false,
      "description": "Set visualizationid and rename file"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "pwsh",
        "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
        "redirectStandardOutput": "false"
      },
      "manualInstructions": [{ "text": "Removing scripts" }],
      "continueOnError": false,
      "description": "Removing scripts"
    }
  ]
}
