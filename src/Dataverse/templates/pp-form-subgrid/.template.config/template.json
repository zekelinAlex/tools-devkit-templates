{
    "$schema": "http://json.schemastore.org/template",
    "author": "NETWORG",
    "identity": "TALXIS.DevKit.Templates.Dataverse.UI.Subgrid",
    "name": "Power Platform: Form Subgrid",
    "shortName": "pp-form-subgrid",
  "description": "Adds a subgrid to a form showing related entity records. Generates row > cell > control. Params: TargetEntityLogicalName, ViewId, RecordsPerPage, EnableQuickFind, EnableViewPicker, EnableChartPicker. Required: FormId, FormType(main/quick), EntityLogicalName, SubgridLabel.",
    "tags": {
        "language": "XML",
        "type": "item"
    },
    "sourceName": "subgridconfig",
    "preferNameDirectory": false,
    "symbols": {
        "SolutionRootPath": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__solution-declarations-root__",
            "defaultValue": ".",
            "isRequired": false,
            "description": "Path to the solution root directory"
        },
        "CellId": {
            "type": "generated",
            "generator": "guid",
            "replaces": "__cell-id__",
            "parameters": {
                "defaultFormat": "d"
            }
        },
        "SubgridLabel": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__subgrid-label__",
            "isRequired": true,
            "displayName": "Subgrid Label Text",
            "description": "Display name for the subgrid section"
        },
        "ControlId": {
            "type": "generated",
            "generator": "guid",
            "replaces": "__control-id__",
            "parameters": {
                "defaultFormat": "d"
            }
        },
        "FormType": {
            "type": "parameter",
            "datatype": "choice",
            "isRequired": true,
            "replaces": "__form-type__",
            "choices": [
                {
                    "choice": "main"
                },
                {
                    "choice": "quick"
                }
            ],
            "description": "Type of form where subgrid will be added: main (main form) or quick (quick create form)"
        },
        "FormId": {
            "type": "parameter",
            "datatype": "string",
            "isRequired": true,
            "defaultValue": "",
            "replaces": "__form-id__",
            "description": "GUID of the specific form where the subgrid will be added"
        },
        "TargetEntityLogicalName": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__target-entity-logical-name__",
            "isRequired": true,
            "displayName": "Target Entity Logical Name",
            "description": "Entity whose records will be displayed in the subgrid (Example: contact, opportunity, custom_entity)"
        },
        "EntityLogicalName": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__entity-logical-name__",
            "isRequired": true,
            "displayName": "Entity Logical Name",
            "description": "Entity where the subgrid will be added (Example: account, contact, custom_entity)"
        },
        "ViewId": {
            "type": "generated",
            "generator": "guid",
            "replaces": "__view-id__",
            "parameters": {
                "defaultFormat": "d"
            }
        }
    },
    "postActions": [
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/add.ps1\" ",
                "redirectStandardOutput": "false"
            },
            "manualInstructions": [
                {
                    "text": "Adding new row to form"
                }
            ],
            "continueOnError": false,
            "description": "Adding new row to form"
        },
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
                "redirectStandardOutput": "false"
            },
            "manualInstructions": [
                {
                    "text": "Removing Scripts"
                }
            ],
            "continueOnError": false,
            "description": "Removing Scripts"
        }
    ]
}