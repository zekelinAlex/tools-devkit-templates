{
    "$schema": "http://json.schemastore.org/template",
    "author": "NETWORG",
    "identity": "TALXIS.DevKit.Templates.Dataverse.WebResource",
    "name": "Power Platform: Web Resource",
    "shortName": "pp-webresource",
  "description": "Registers a web resource in a Dataverse solution: JsBuildTarget.xml (MSBuild target: builds the script library project -> validates JS output -> copies to WebResources/ with publisher prefix) + {publisher}_{name}.data.xml (WebResourceId, Name, DisplayName, WebResourceType, Version). Works with pp-script-library: compiled JS gets deployed as {publisher}_{name}.js.",
    "tags": {
        "language": "XML",
        "type": "item"
    },
    "sourceName": "examplesourcename",
    "preferNameDirectory": true,
    "symbols": {
        "SolutionRootPath": {
            "type": "parameter",
            "datatype": "text",
            "defaultValue": ".",
            "replaces": "SolutionDeclarationsRoot",
            "fileRename": "SolutionDeclarationsRoot"
        },
        "PublisherPrefix": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__publisher-prefix__",
            "fileRename": "__publisher-prefix__",
      "defaultValue": "__publisher-prefix-default-value__"
        },
        "WebResourceItemPath": {
            "type": "parameter",
            "datatype": "text",
            "replaces": "__web-resource-item-path__",
            "fileRename": "__web-resource-item-path__",
            "isRequired": true
        }
    },
    "postActions": [
        {
			"actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
			"args": {
				"executable": "pwsh",
				"args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Init.ps1\"",
				"redirectStandardOutput": "false"
			},
			"manualInstructions": [
				{
					"text": "Set missing metadata values in template files and renaming files if necessary"
				}
			],
			"condition": "(PublisherPrefix == \"__publisher-prefix-default-value__\")",
			"description": "Setting missing metadata values in template files and renaming files if necessary"
		},
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/SetWebresourceType.ps1\"",
                "redirectStandardOutput": "false"
            },
            "description": "Set webresource type"
        },
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/AddToSolution.ps1\"",
                "redirectStandardOutput": "false"
            },
            "description": "Add to solution"
        },
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/AddToCustomizationsXml.ps1\"",
                "redirectStandardOutput": "false"
            },
            "description": "Add to customizations XML"
        },
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/SetupWRDataFile.ps1\"",
                "redirectStandardOutput": "false"
            },
            "description": "Setup WR data file"
        },
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "pwsh",
                "args": "-noprofile -executionpolicy bypass -File \"./.template.scripts/Cleanup.ps1\"",
                "redirectStandardOutput": "false"
            },
            "description": "Cleanup"
        }
    ]
}