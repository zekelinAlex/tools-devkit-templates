{
  "$schema": "http://json.schemastore.org/template",
  "author": "NETWORG",
  "identity": "TALXIS.DevKit.Templates.Dataverse.FormWithFields",
  "name": "Power Platform: Form with Fields (composite)",
  "shortName": "pp-form-with-fields",
  "description": "Composite template that scaffolds a complete form for an existing entity in a single call: tab + section + rows + cells + controls. Replaces the 7-step pp-entity-form -> pp-form-tab -> pp-form-column -> pp-form-section -> pp-form-row -> pp-form-cell -> pp-form-control chain. Pass fields as 'name:type[:displayName]' separated by commas. The generated FormId is printed at the end of the run. Supports FormType main and dialog. First-version control types: Text, MultilineText, WholeNumber, Decimal, Float, Currency, DateTime, OptionSet.",
  "classifications": ["Dataverse", "Power Platform"],
  "tags": {
    "language": "XML",
    "type": "item"
  },
  "sourceName": "examplecustomentity",
  "preferNameDirectory": false,
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AddMainForm)",
          "exclude": [
            "SolutionDeclarationsRoot/Entities/__entity-logical-name__/FormXml/main/*"
          ]
        },
        {
          "condition": "(!AddDialogForm)",
          "exclude": [
            "SolutionDeclarationsRoot/Dialogs/*"
          ]
        }
      ]
    }
  ],
  "symbols": {
    "SolutionRootPath": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ".",
      "replaces": "SolutionDeclarationsRoot",
      "fileRename": "SolutionDeclarationsRoot",
      "isRequired": false,
      "description": "Path to the solution root directory (default: '.')"
    },
    "EntityLogicalName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "__entity-logical-name__",
      "fileRename": "__entity-logical-name__",
      "description": "Logical name of the entity (e.g., udpp_warehouseitem)"
    },
    "FormType": {
      "type": "parameter",
      "datatype": "choice",
      "isRequired": false,
      "defaultValue": "main",
      "replaces": "__form-type__",
      "choices": [
        { "choice": "main",   "description": "Main form" },
        { "choice": "dialog", "description": "Dialog form" }
      ],
      "description": "Form type: main (entity main form) or dialog (custom dialog form)"
    },
    "FormName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": false,
      "defaultValue": "Generated Form",
      "replaces": "__form-name__",
      "description": "Display name of the form"
    },
    "DialogUniqueName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": false,
      "defaultValue": "unknown",
      "replaces": "__dialog-unique-name__",
      "description": "Unique name for dialog forms. If 'unknown', synthesized as '<entity-prefix>_<form-name>dialog'. Ignored for FormType=main."
    },
    "Fields": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "replaces": "__fields__",
      "description": "Comma-separated list of fields in the form 'name:type[:displayName]'. Supported types: Text, MultilineText, WholeNumber, Decimal, Float, Currency, DateTime, OptionSet. Example: 'udpp_name:Text:Name,udpp_qty:WholeNumber:Quantity'."
    },
    "AddMainForm": {
      "type": "computed",
      "value": "(FormType == \"main\")",
      "description": "Auto-computed: true when FormType is main"
    },
    "AddDialogForm": {
      "type": "computed",
      "value": "(FormType == \"dialog\")",
      "description": "Auto-computed: true when FormType is dialog"
    },
    "FormId": {
      "type": "parameter",
      "generator": "guid",
      "defaultValue": "unknown",
      "replaces": "__form-id__",
      "fileRename": "__form-id__",
      "parameters": {
        "defaultFormat": "d"
      },
      "description": "Unique identifier of the form (auto-generated GUID if omitted)"
    },
    "__1formexample-id__": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__1formexample-id__",
      "parameters": { "defaultFormat": "d" }
    },
    "__2formexample-id__": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__2formexample-id__",
      "parameters": { "defaultFormat": "d" }
    },
    "__3formexample-id__": {
